rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the caller owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Customer User Profile Documents (users/{userId})
    match /users/{userId} {
      // Only the authenticated customer can read their own profile
      allow read: if isOwner(userId);

      // Customer can create/update only their own profile data, without escalating privileges
      allow create, update: if isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role']));

      // Never allow client deletion of user records
      allow delete: if false;

      // User's order subcollection
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow write: if false; // Orders are written authoritatively by backend serverless API
      }
    }

    // 2. Global Orders Collection (orders/{orderId})
    match /orders/{orderId} {
      // Customers can read only orders they own (either by userId or customerUid)
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerUid == request.auth.uid
      );

      // Direct client creation, update, and deletion are strictly forbidden.
      // All orders must be validated and created through the backend Vercel Function
      // using the authoritative server-side catalog and pricing.
      allow create, update, delete: if false;
    }

    // 3. Database Idempotency Collection (order_idempotency/{key})
    match /order_idempotency/{key} {
      // Direct browser client access is strictly forbidden.
      // Managed exclusively by backend Firebase Admin SDK inside atomic database transactions.
      allow read, write: if false;
    }

    // 4. Deny access to any unspecified collection by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
