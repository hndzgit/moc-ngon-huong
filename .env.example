# Public Firebase web configuration only. Never put Admin SDK/service-account secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave unset for local development or Vercel. GitHub Actions sets /moc-ngon-huong/.
# VITE_BASE_PATH=/moc-ngon-huong/
