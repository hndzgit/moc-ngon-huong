# ============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Frontend Bundle)
# Public Firebase web configuration only. Never put Admin SDK/private secrets here!
# ============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional custom base path (Default '/' for Vercel/Custom Domain)
# VITE_BASE_PATH=/

# ============================================================================
# SERVER-SIDE ONLY ENVIRONMENT VARIABLES (Vercel Functions / Serverless Runtime)
# CONFIGURE DIRECTLY IN VERCEL PROJECT SETTINGS > ENVIRONMENT VARIABLES.
# NEVER PREFIX WITH VITE_ AND NEVER COMMIT SECRETS TO GIT.
# ============================================================================
# Option 1: Full JSON string of Firebase Service Account
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option 2: Individual variables (Recommended for Vercel dashboard)
# FIREBASE_PROJECT_ID=moc-ngon-huong
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@moc-ngon-huong.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
